{
  "name": "amex-assistant",
  "version": "0.1.0",
  "description": "Tampermonkey userscript to add an Amex Offer to multiple cards from one panel. Local-only, no telemetry.",
  "type": "commonjs",
  "private": true,
  "scripts": {
